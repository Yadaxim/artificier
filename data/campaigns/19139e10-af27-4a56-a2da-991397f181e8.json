      },
      "name": "The Blackwood Manor",
      "concept": "A seemingly abandoned manor house with a dark basement that conceals supernatural horrors. What appears to be a simple two-story exploration reveals layers of family secrets, occult practices, and restless spirits that have claimed the property as their domain.",
      "tone": "grim",
      "history": {
        "origin": "Built by the wealthy Blackwood family as their country estate in 1847",
        "original_purpose": "Served as a luxurious family home and center for high society gatherings",
        "downfall": "The family patriarch delved into forbidden necromantic rituals in the basement, ultimately causing a catastrophic event that killed the entire household",
        "timeline": "Abandoned for over 30 years, now haunted by vengeful spirits and twisted by dark magic"
      },
      "world_context": "Located on the outskirts of a farming community, the manor has become a source of local fear and superstition, with livestock found drained of blood and strange lights seen in the windows at night",
      "level_range": "levels 4-6",
      "status": "UNVISITED"
    }
  },
